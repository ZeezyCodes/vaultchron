# Environment file format is KEY=value lines without export or quotes problems.
# If installed to a custom directory, override ExecStart:
#   systemctl --user edit vaultchron.service
# The empty ExecStart= line resets the original command:
#   [Service]
#   ExecStart=
#   ExecStart=/path/to/vaultchron
# View service execution logs via:
#   journalctl --user -u vaultchron

[Unit]
Description=VaultChron Devlog Engine

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/vaultchron/env
ExecStart=%h/.local/bin/vaultchron
TimeoutStartSec=45min
